# Wallets for running examples/complete-flow.js
SENDER_PRIVATE_KEY=0x...
RECIPIENT_PRIVATE_KEY=0x...

# Off-chain ZKP (Tempo / offchainZKP=true) uploads proof bytes to the self-hosted
# StableTrust IPFS (Kubo). Also used by the opt-in live test: `npm run test:live`.
STABLETRUST_IPFS_UPLOAD_URL=http://<host>/v1/proofs
STABLETRUST_IPFS_GATEWAY_URL=http://<host>
STABLETRUST_IPFS_API_KEY=

# Required for examples/anonymous-flow.js
EVM_RPC=http://127.0.0.1:8545
FAIRYCLOAK_URL=http://127.0.0.1:8080
CHAIN_ID=31337
TOKEN_ADDRESS=0x...
TOKEN_DECIMALS=6
ANON1_PRIVATE_KEY=0x...
ANON2_PRIVATE_KEY=0x...
WITHDRAW_DEST_PK=0x...
