{
  "name": "@fairblock/stabletrust",
  "version": "2.0.10",
  "description": "SDK for confidential transfers using homomorphic encryption and zero-knowledge proofs",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "sideEffects": [
    "**/*.wasm"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./wasm": "./pkg/confidential_transfer_proof_generation.js",
    "./pkg/*.wasm": "./pkg/*.wasm"
  },
  "files": [
    "src/",
    "pkg/",
    "examples/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fairblock/stabletrust-sdk"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:live": "node --test test/ipfs-live.mjs",
    "check:abi": "node scripts/check-contract-abi.mjs",
    "check": "npm run check:abi && npm test"
  },
  "keywords": [
    "confidential",
    "transfers",
    "zero-knowledge",
    "encryption",
    "blockchain",
    "privacy"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/bls12-381": "^1.4.0",
    "@noble/hashes": "^1.3.2",
    "@stablelib/chacha20poly1305": "^1.0.1",
    "axios": "^1.16.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
